# Másold le .env.deploy.local néven (gitignore-olt), és töltsd ki a saját adataiddal.
## FTPS-nél a tárhely szerverének neve kell (erre szól a tanúsítvány), nem IP-cím és nem ftp.delawer.hu.
FTP_HOST=s036.netmask.hu
FTP_HOST=37.221.213.5
FTP_USER=delawerh
# Ha üresen hagyod, a script futáskor rejtett beírással kéri.
FTP_PASSWORD=delawerh
# Az a mappa az FTP-n, ahová Total Commanderrel is a dist/ tartalmát másolod.
FTP_REMOTE_DIR=/public_html/solvyr-prime
# true = FTPS (explicit TLS, ajánlott), implicit = FTPS a 990-es porton, false = titkosítatlan FTP
FTP_SECURE=true
# FTP_PORT=21
# Feltöltés után ellenőrzi, hogy az élő oldal a friss index.html-t adja.
DEPLOY_PUBLIC_URL=https://delawer.hu/solvyr-prime/
